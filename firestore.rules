rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Authentication helper
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Ownership helper
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Safe Admin helper check
    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token != null && 'email' in request.auth.token && (request.auth.token.email.lower() == 'admin@gmail.com' || request.auth.token.email.lower() == 'adribuellet@hotmail.com')) ||
        (request.auth.token != null && 'admin' in request.auth.token && request.auth.token.admin == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         'accountType' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountType == 'admin') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         'roles' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['admin']))
      );
    }

    // Check if user account is active (not suspended or blocked by admin)
    function isActiveUser() {
      return isAuthenticated() && (
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        !('accountStatus' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountStatus == 'active'
      );
    }

    // Users Collection Rules
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isOwner(userId) || isAdmin();

      // Blocked users subcollection
      match /blocked_users/{blockedId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Top-level Blocked Users collection
    match /blockedUsers/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Actions Collection Rules
    match /actions/{actionId} {
      allow read: if true;
      allow create: if isActiveUser();
      allow update: if isAuthenticated() && (
        // Case 1: Admin moderation or independent review (strictly prevent self-validation)
        (isAdmin() && resource.data.userId != request.auth.uid) ||
        // Case 2: Regular user interaction or person-based validator
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'moderationStatus', 'moderatedBy', 'moderatedAt', 'moderationReason',
            'independentReviewStatus', 'reviewedByAdminId', 'reviewedByAdminName', 'reviewedAt', 'rejectionReason'
          ]) &&
          (
            // Normal interaction (likes, comments, content updates without tampering validationStatus)
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['validationStatus']) ||
            // Or designated external person validator
            (resource.data.validatorId != null && resource.data.validatorId == request.auth.uid)
          )
        )
      );
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isActiveUser();
      }
    }

    // Moderation Reports Collection
    match /moderationReports/{reportId} {
      allow read, write: if isAuthenticated();
    }

    // Moderation Audit Log Collection
    match /moderationActions/{actionId} {
      allow read, write: if isAuthenticated();
    }

    // Moderation Settings Collection (Blocked Words)
    match /moderationSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Notifications Collection Rules
    match /notifications/{notificationId} {
      allow read, write: if isAuthenticated();
    }
  }
}
